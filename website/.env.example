# ==============================================================================
# Shift Puzzle Landing Page — Production Environment Variables
# ==============================================================================
# All variables are build-time public variables consumed by Next.js static export.
# In Cloudflare Pages, define these in Settings > Environment Variables (Production).

# ------------------------------------------------------------------------------
# 1. Canonical Site & Domain Configuration
# ------------------------------------------------------------------------------
# Set to your live production domain (e.g., https://shift-puzzle.pages.dev or custom domain).
# Leave unset or empty during local development to use the deployment placeholder.
NEXT_PUBLIC_SITE_URL=https://shiftpuzzle.app

# ------------------------------------------------------------------------------
# 2. APK Download & Distribution Configuration
# ------------------------------------------------------------------------------
# Direct URL to the production release APK hosted on external object storage
# (e.g. Cloudflare R2, AWS S3, or GitHub Releases).
# Defaults to '/app-release.apk' for local testing/fallback.
# Example: https://cdn.example.com/shift-puzzle-v1.0.0.apk
NEXT_PUBLIC_APK_URL=/app-release.apk

# Release specifications (derived from build metadata)
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APK_SIZE=50.0 MB
NEXT_PUBLIC_RELEASE_DATE=October 2026

# ------------------------------------------------------------------------------
# 3. Adsterra SmartLink Monetization (Optional)
# ------------------------------------------------------------------------------
# Optional external direct sponsor offer link.
# CRITICAL: If absent or empty, the sponsor card remains completely hidden.
# NEVER commit a real or fake ad link into source code.
# NEXT_PUBLIC_ADSTERRA_SMARTLINK_URL=https://...

# ------------------------------------------------------------------------------
# 4. Funnel Analytics (Optional)
# ------------------------------------------------------------------------------
# Optional ingest endpoint for privacy-first funnel events (page views, clicks).
# If absent or unreachable, telemetry fails silently with zero network requests.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://analytics.example.com/api/v1/event

# ------------------------------------------------------------------------------
# 5. Social & Contact Links
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=support@shiftpuzzle.app
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@shiftpuzzle
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@shiftpuzzle
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/shiftpuzzle
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/shiftpuzzle
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/shiftpuzzle
